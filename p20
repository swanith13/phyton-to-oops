class Student:
    def __init__(self, name, age):
        self.name = name
        self.age = age

class CollegeStudent(Student):
    def __init__(self, name, age, course):
        super().__init__(name, age)
        self.course = course

s = CollegeStudent("kprit", 18, "CSE")

print("Name:", s.name)
print("Age:", s.age)
print("Course:", s.course)
