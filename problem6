class Shape:
    pass


class Circle(Shape):
    r = 5

    def area(self):
        A = 3.14 * self.r * self.r
        print("Area of Circle:", A)


class Rectangle(Shape):
    l = 4
    b = 6

    def area(self):
        B = self.l * self.b
        print("Area of Rectangle:", B)


class Triangle(Shape):
    b = 2
    h = 4

    def area(self):
        C = 0.5 * self.b * self.h
        print("Area of Triangle:", C)


C = Circle()
R = Rectangle()
T = Triangle()

C.area()
R.area()
T.area()
